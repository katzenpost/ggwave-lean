import Tests.Common

/-! Checks against waveforms rendered by C ggwave 060aec7 (`Tests/vectors`,
regenerated by `tools/gen-vectors.sh`). Needs no C toolchain. -/

open Ggwave

namespace Tests

structure Vector where
  name : String
  protocol : Protocol
  fixed : Option Nat
  rateOut : Float
  volume : Nat
  payload : ByteArray
  rate : Float
  spf : Nat
  samples : Array Int

def vectorsDir : System.FilePath := "Tests" / "vectors"

def loadVectors : IO (Array Vector) := do
  let manifest ← IO.FS.readFile (vectorsDir / "manifest.txt")
  let lines := manifest.splitOn "\n" |>.filter fun l => !l.isEmpty && !l.startsWith "#"
  let vs ← lines.toArray.mapM fun l => do
    let f := (l.splitOn " ").toArray
    let fixed := f[2]!.toNat!
    return {
      name := f[0]!
      protocol := (Protocol.ofId? f[1]!.toNat!).getD .audibleFast
      fixed := if fixed == 0 then none else some fixed
      rateOut := f[3]!.toNat!.toFloat
      volume := f[4]!.toNat!
      payload := unhex f[5]!
      rate := f[6]!.toNat!.toFloat
      spf := f[7]!.toNat!
      samples := ofI16Bytes (← IO.FS.readBinFile (vectorsDir / (f[0]! ++ ".i16"))) }
  if vs.size < 25 then throw (.userError "missing vectors")
  return vs

/-- Lean's samples, as i16, against C's: the largest difference in LSB and how many differ. -/
def encoderReproducesC (vs : Array Vector) : T Unit := do
  IO.println "  vector                 max |Lean - C| (i16 LSB)   samples differing"
  for v in vs do
    let p := params v.fixed v.rate v.rateOut (rate := v.rate) (spf := v.spf)
    let some r ← expectOk (encode p v.protocol v.volume v.payload) v.name | continue
    let r := toI16 r
    check (r.size == v.samples.size) s!"{v.name}: {r.size} samples, C has {v.samples.size}"
    let mut maxDiff := 0
    let mut differing := 0
    for i in [0:min r.size v.samples.size] do
      let d := (r[i]!.toInt - v.samples[i]!).natAbs
      maxDiff := max maxDiff d
      if d != 0 then differing := differing + 1
    IO.println s!"  {v.name.pushn ' ' (22 - v.name.length)} {maxDiff}                          {differing} of {r.size}"
    check (maxDiff ≤ 1) s!"{v.name}: differs from C by {maxDiff} LSB"

def decoderReadsC (vs : Array Vector) : T Unit := do
  for v in vs do
    let rate := v.rateOut.toUInt64.toNat
    for (noise, seed) in [(0.0, 0), (0.1, 1), (0.3, 2)] do
      let x := addNoise (pad (ofI16 v.samples) (rate / 7) rate) noise seed
      let some d ← expectOk (Decoder.init (params v.fixed v.rateOut v.rate (rate := v.rate) (spf := v.spf)) Protocol.all) v.name
        | continue
      let got := decodeAll d x 1000
      check (got.contains v.payload) s!"{v.name} noise {noise}: got {got.toList.map hex}"

end Tests
